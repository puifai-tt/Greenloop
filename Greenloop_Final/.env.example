# Development: leave empty — Vite proxies /api to http://localhost:4000 (see vite.config.js).
# Production build: set the full URL of the deployed API (and add this site's origin to CORS_ORIGIN in the backend .env).
# VITE_API_URL=https://api.example.com/api
PORT=4000
CORS_ORIGIN=http://localhost:5173
DB_HOST=localhost
DB_PORT=3306
DB_USER=greenloop
DB_PASSWORD=your_actual_mysql_password
DB_NAME=greenloop
JWT_SECRET=super_secret_jwt_key_that_is_at_least_32_characters_long
JWT_EXPIRES_IN=8h
REDEEM_EXPIRE_DAYS=30
# TRUST_PROXY=1
